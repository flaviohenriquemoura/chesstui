    Grid {
        grid-size: 9 9;
        grid-columns: 10 10 10 10 10 10 10 10 10;
        grid-rows: 6 6 6 6 6 6 6 6 6;
        
        grid-gutter: 0;
        
        align: center middle;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
    }

    CTabuleiro {
        width: 10;
        height: 6;
        content-align: center middle;
        margin: 0;
        padding: 0;


 }

